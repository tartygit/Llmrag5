# Software Development Document Environment (SDDE) Configuration
# App Name Config
APP_NAME="Software Development Document Environment"

# Database configs
# Available options: ORACLE, POSTGRESQL, SQLSERVER, H2 (Default for demo/local)
DB_TYPE=H2
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sdde_db
DB_USER=sa
DB_PASS=password

# Directory Polling Configs
POLLING_DIR="./polling_folder"
POLLING_INTERVAL_MS=5000

# Authentication Toggles
# Active Directory / LDAP Settings (LDAP or DATABASE)
AUTH_METHOD=DATABASE
LDAP_PROVIDER_URL="ldap://localhost:389"
LDAP_SECURITY_PRINCIPAL="cn=admin,dc=cth,dc=com"
LDAP_SECURITY_CREDENTIALS="admin_password"

# Notification switches
ENABLE_SMS_AUTH_SIGNUP=false
ENABLE_EMAIL_AUTH_SIGNUP=false
ENABLE_APPROVER_SMS_NOTIFY=false
ENABLE_APPROVER_EMAIL_NOTIFY=false

# LLM / RAG settings
OLLAMA_HOST=http://localhost:11434
MODEL_CHAT=llama3.2:latest
MODEL_EMBED=nomic-embed-text

# Clerk Authentication Settings (for RAG App, can fallback to mock in local offline mode)
CLERK_PUBLISHABLE_KEY=pk_test_bW9jay1jbGVyay1rZXktOTIubGNsLmNsdXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_mockSecretKey1234567890abcdefghijklmnopqrstuv

# Default Application Code (3 characters)
DEFAULT_APP_CODE=SDE
